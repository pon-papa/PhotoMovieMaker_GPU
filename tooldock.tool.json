{
  "connector_version": 1,
  "tool_id": "photomoviemaker-gpu",
  "name": "PhotoMovieMaker GPU",
  "version": "0.1.1+external-api",
  "api_version": 1,
  "description": "写真フォルダーからMP4スライドショーを作るローカルツール。写真の解析・代替候補グループ・上映計画（Project JSON）・計画どおりの MP4 書き出しをCLIから利用できます。元の写真は読むだけです。",
  "namespace": "slideshow",
  "interface": {
    "type": "json_cli",
    "runtime": "py",
    "entry": "pmm_cli.py",
    "arguments": "flags",
    "output": "envelope",
    "progress": "stderr_jsonl"
  },
  "capabilities": [
    "media_scan",
    "photo_analysis",
    "photo_recommendation",
    "variant_family",
    "candidate_group",
    "subject_detection",
    "project_plan",
    "render_final"
  ],
  "actions": [
    {
      "name": "get_capabilities",
      "title": "できること",
      "description": "PhotoMovieMaker GPU（写真からMP4スライドショーを作るローカルツール）で使える操作・対応形式・モデルの有無を返します。",
      "command": "capabilities",
      "access": "read",
      "input_schema": {"type": "object", "properties": {}, "additionalProperties": false},
      "output_schema": {"type": "object", "required": ["tool", "version", "api_version", "capabilities"]},
      "timeout_seconds": 60
    },
    {
      "name": "scan_media",
      "title": "写真の一覧",
      "description": "指定フォルダー直下の写真を一覧にします（ファイル名・大きさ・縦横）。サブフォルダーは見ません。写真は読むだけです。",
      "command": "scan",
      "access": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "folder": {"type": "string", "minLength": 3, "maxLength": 1000, "x-path": "media_folder", "x-flag": "--folder",
                     "description": "写真のフォルダー（絶対パス）"}
        },
        "required": ["folder"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["folder", "count", "media"],
                        "properties": {"count": {"type": "integer"}, "media": {"type": "array"}}},
      "timeout_seconds": 300
    },
    {
      "name": "analyze_photos",
      "title": "おすすめ解析",
      "description": "写真を解析し、代替候補グループ（どれか1枚を選べば残りは外してよい写真の群）・同じ写真の別バージョン（カラー版と白黒版など）・群の中での推奨度（星）・人物/犬の数・撮影時刻を返します。星は写真の価値ではなく群の中での順位です。写真を外したり並べ替えたりはしません。数百枚で数分かかります。",
      "command": "analyze",
      "access": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "folder": {"type": "string", "minLength": 3, "maxLength": 1000, "x-path": "media_folder", "x-flag": "--folder",
                     "description": "写真のフォルダー（絶対パス）"},
          "use_embedding": {"type": "boolean", "default": true, "x-flag-false": "--no-embedding",
                            "description": "画像embeddingで代替候補グループを作る（falseで従来方式）"},
          "detect_subjects": {"type": "boolean", "default": true, "x-flag-false": "--no-subjects",
                              "description": "人物の顔と犬を数える"}
        },
        "required": ["folder"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["folder", "count", "engine", "summary", "groups", "photos"],
                        "properties": {"photos": {"type": "array"}, "groups": {"type": "array"}}},
      "timeout_seconds": 3600,
      "progress": true
    },
    {
      "name": "create_project_plan",
      "title": "上映計画の叩き台",
      "description": "Project JSON（上映計画）の叩き台を作ります。写真はすべて使う状態・フォルダー順で並びます。どれを外し、どう並べ、何秒見せるかはあなたが決めて、この JSON を書き換えてください。save_to を指定すると *.photomovie.json として保存します。",
      "command": "plan",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "folder": {"type": "string", "minLength": 3, "maxLength": 1000, "x-path": "media_folder", "x-flag": "--folder",
                     "description": "写真のフォルダー（絶対パス）"},
          "title": {"type": "string", "maxLength": 200, "x-flag": "--title",
                    "description": "タイトル（省略するとフォルダー名）"},
          "analyze": {"type": "boolean", "default": true, "x-flag-true": "--analyze",
                      "description": "解析結果（グループ・星）を計画に含める"},
          "use_embedding": {"type": "boolean", "default": true, "x-flag-false": "--no-embedding"},
          "detect_subjects": {"type": "boolean", "default": true, "x-flag-false": "--no-subjects"},
          "target_duration_seconds": {"type": "number", "minimum": 1, "maximum": 86400, "x-flag": "--target-duration",
                                      "description": "目標の長さ（秒）。記録するだけで自動調整はしません"},
          "save_to": {"type": "string", "maxLength": 1000, "x-path": "output_file", "x-suffixes": [".photomovie.json"],
                      "x-flag": "--save", "description": "保存先（絶対パス、*.photomovie.json）"},
          "overwrite": {"type": "boolean", "default": false, "x-flag-true": "--overwrite"}
        },
        "required": ["folder"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["project", "saved_to"],
                        "properties": {"project": {"type": "object"}, "saved_to": {"type": ["string", "null"]}}},
      "timeout_seconds": 3600,
      "progress": true
    },
    {
      "name": "validate_project",
      "title": "上映計画の確認",
      "description": "保存した Project JSON（*.photomovie.json）が正しい形かを確かめて、中身を返します。",
      "command": "validate",
      "access": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_file": {"type": "string", "minLength": 3, "maxLength": 1000, "x-path": "project_file",
                           "x-suffixes": [".photomovie.json"], "x-flag": "--project",
                           "description": "Project ファイル（絶対パス）"}
        },
        "required": ["project_file"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["project", "valid"]},
      "timeout_seconds": 60
    },
    {
      "name": "render",
      "title": "MP4 を書き出す",
      "description": "保存した Project JSON（上映計画）のとおりに、画面と同じ処理で MP4 スライドショーを書き出します。使うのは enabled が true の写真だけで、order の順に並びます。video（解像度・秒数・カメラワーク）と title_card も計画どおりです。BGM 付きの書き出しはまだできません（bgm_segments は空にしてください）。photo_folder は計画の source_folder と同じフォルダーを指定します。写真と計画ファイルは読むだけです。完成した MP4 と *_settings.json だけを書き出し先に置き、中止・失敗のときは何も残しません。同じ名前のファイルは overwrite を指定しない限り上書きしません。写真の枚数と解像度しだいで数十秒〜数分かかります。",
      "command": "render",
      "access": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_file": {"type": "string", "minLength": 3, "maxLength": 1000, "x-path": "project_file",
                           "x-suffixes": [".photomovie.json"], "x-flag": "--project",
                           "description": "Project ファイル（絶対パス、*.photomovie.json）"},
          "photo_folder": {"type": "string", "minLength": 3, "maxLength": 1000, "x-path": "media_folder", "x-flag": "--folder",
                           "description": "写真のフォルダー（計画の source_folder と同じ、絶対パス）"},
          "output_file": {"type": "string", "minLength": 3, "maxLength": 1000, "x-path": "output_file",
                          "x-suffixes": [".mp4"], "x-flag": "--output",
                          "description": "書き出す MP4（絶対パス）"},
          "overwrite": {"type": "boolean", "default": false, "x-flag-true": "--overwrite"}
        },
        "required": ["project_file", "photo_folder", "output_file"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "required": ["output", "bytes", "photos", "frames", "duration_seconds", "encoder_used"],
                        "properties": {"output": {"type": "string"}, "frames": {"type": "integer"}}},
      "timeout_seconds": 3600,
      "cancellable": true,
      "progress": true
    }
  ],
  "health_check": {"action": "get_capabilities"},
  "project_format": {"kind": "photomoviemaker.project", "schema_version": 1, "file_suffix": ".photomovie.json"},
  "requirements": {
    "python": ">=3.11",
    "packages": ["pillow", "numpy", "opencv-python", "imageio-ffmpeg", "onnxruntime"],
    "local_ai": []
  },
  "data_policy": {
    "source_media": "read_only",
    "network": "none",
    "runtime_download": false
  }
}
